{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BandwidthX",
  "version": "2.3.0",
  "identifier": "com.bandwidthx.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{
      "title": "BandwidthX",
      "width": 1360,
      "height": 860,
      "minWidth": 1120,
      "minHeight": 720,
      "resizable": true,
      "fullscreen": false,
      "center": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": ["resources/bandwidthx-service.exe"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/nsis-hooks.nsh",
        "languages": ["English"]
      }
    }
  }
}
